
{
    "geode": "5.11.2",
    "gd": {
        "android": "*"
    },
    "id": "mfkr0001.megasoft",
    "name": "Mega Soft",
    "version": "v1.0.0",
    "developer": "mfkr0001",
    "description": "Mega Soft tools for Geometry Dash",
    "settings": {
        "show-fps": {
            "type": "bool",
            "name": "Show FPS",
            "description": "Display engine statistics",
            "default": false
        },
        "noclip": {
            "type": "bool",
