            "default": false
        },
        "speed-multiplier": {
            "type": "float",
            "name": "Speed multiplier",
            "description": "Experimental update-time multiplier",
            "default": 1.5,
            "min": 0.5,
            "max": 3.0,
            "control": {
                "slider": true,
                "slider-step": 0.1
            }
        }
    }
}
